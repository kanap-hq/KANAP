PORT=8080
# Run mode (NODE_ENV is read when APP_ENV is absent):
#   - development (also dev, local, test): workstation conveniences (links that follow a local
#     development host, CORS open to every origin when CORS_ORIGINS is empty, PLATFORM_ADMIN_EMAILS=*).
#   - production (also prod): APP_BASE_URL and CORS_ORIGINS required at start, Secure cookie forced.
#   - any other value or none: production rules for links, browser origins and platform
#     administration; start-up warnings instead of refusals; the cookie follows the request.
APP_ENV=development
DATABASE_URL=postgres://app:app@db:5432/appdb
# Bounded waits of each request transaction, in milliseconds (0 = no limit).
# Defaults: 5000 / 30000 / 60000. Long routes raise them with @LongRunningRequest.
# DB_LOCK_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# API processes (Node cluster in the image's entrypoint; default 1) and database connections per
# process (2 at least). API_WORKERS x DB_POOL_MAX must fit PostgreSQL's max_connections minus ~15
# (checked at start, warning only). QA has 3.8 GB and no swap: keep 1 there. See doc/architecture.md.
# API_WORKERS=1
# DB_POOL_MAX=20
# On stop, time given to the requests in flight, their notifications, running scheduled tasks and
# queued emails (ms; the compose files stop the container at 30 s).
# SHUTDOWN_DRAIN_TIMEOUT_MS=20000
# Enables GET /ops/metrics with "Authorization: Bearer <token>" (24+ characters).
# OPS_METRICS_TOKEN=
# LOG_LEVEL=debug also logs the scheduled-task ticks another API process took.
# REQUIRED: set a strong random secret (example: openssl rand -base64 32)
JWT_SECRET=
# Address users open KANAP at. Links in emails and sign-in redirects are built from it, never
# from the request's Host headers (multi-tenant: the tenant's address is derived from it, then
# from APP_URL, e.g. https://app.kanap.net -> https://<tenant>.kanap.net). In development mode only,
# a request on a local development host (lvh.me, localhost, *.localhost, dev.kanap.net and their
# subdomains) keeps its links on that host. Without it, features that send a link answer
# "application URL is not configured" and scheduled notification runs are skipped.
APP_BASE_URL=http://localhost:5173

# Browser origins allowed to call the API with cookies (comma-separated). Always allowed as
# well: the application's own address (APP_BASE_URL, or the tenant's address) and the address
# of the request itself (same host and port as the Host header; outside production mode, same
# host name when the Host header carries no port). A refused origin gets a 403.
# Patterns:
#   - Exact origin: https://app.kanap.net
#   - Wildcard subdomain: https://*.kanap.net (multi-tenant: matches the tenant of each request
#     only; single-tenant: still accepted in this version, with a start-up warning)
#   - Wildcard port: http://localhost:* (development)
# In development mode, patterns match as written and an empty value allows every origin.
# Examples by environment:
#   - Local dev: http://localhost:*,http://*.lvh.me:*
#   - Dev/QA: https://*.dev.kanap.net
#   - Production: https://*.kanap.net
#   - On-prem: https://kanap.customer.internal (the exact address)
# IMPORTANT: production mode refuses to start without it; other modes warn and allow only the
# application's address and the request's own address. With neither CORS_ORIGINS nor an
# application address (APP_BASE_URL, PUBLIC_APP_URL, multi-tenant APP_URL), a mode other than
# production or development still allows every origin in this version, with a start-up warning.
CORS_ORIGINS=http://localhost:*,http://*.lvh.me:*

# Optional local bootstrap admin (disabled by default)
# When enabling, set a strong unique ADMIN_PASSWORD first.
SEED_ADMIN=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Rate limiting (app-level)
# Enabled by default; set RATE_LIMIT_ENABLED=false to disable.
RATE_LIMIT_ENABLED=true
# IMPORTANT: Set to true in deployed environments behind a reverse proxy (Cloudflare/Nginx).
# When false (default), Express ignores X-Forwarded-For and all requests share one rate-limit
# bucket (the proxy's IP). QA/prod with Cloudflare+Nginx MUST set this to true.
RATE_LIMIT_TRUST_PROXY=false

# CAPTCHA protection (Cloudflare Turnstile)
# Modes:
#   - off: no CAPTCHA verification
#   - monitor: verify when possible, log failures, do not block requests
#   - enforce: require valid CAPTCHA tokens (recommended for production)
CAPTCHA_MODE=off
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Default tenant slug for multitenancy
# Set to your tenant slug (e.g., 'mycompany')
DEFAULT_TENANT_SLUG=default
MARKETING_BASE_URL=https://www.kanap.net
PLATFORM_ADMIN_HOST=platform-admin.kanap.net
# Comma-separated emails granted platform admin rights.
# Falls back to DB role 'administrator' if empty. Supports wildcard '*' (use with caution).
PLATFORM_ADMIN_EMAILS=

# Email (Resend)
# Cloud deployments use Resend. Single-tenant deployments can use either Resend or SMTP.
# Leave blank in local dev to disable sending.
RESEND_API_KEY=
# Optional override for From header
RESEND_FROM_EMAIL="KANAP <no-reply@kanap.net>"
# Email (SMTP - single-tenant/on-prem only)
# SMTP is ignored in multi-tenant/cloud mode.
# SMTP_HOST=smtp.company.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="KANAP <noreply@company.com>"
# Email queue and retry tuning (optional)
# Minimum gap between outbound email send attempts (ms).
# Defaults: Resend 700ms, SMTP 2100ms (keeps Microsoft 365 SMTP AUTH under 30 messages/minute).
# EMAIL_QUEUE_MIN_INTERVAL_MS=
# Automatic retries when Resend returns a rate-limit response (429).
# EMAIL_RATE_LIMIT_MAX_RETRIES=5
# Exponential backoff settings for 429 retries (ms).
# EMAIL_RATE_LIMIT_RETRY_BASE_MS=1500
# EMAIL_RATE_LIMIT_RETRY_MAX_MS=30000
# EMAIL_RATE_LIMIT_RETRY_JITTER_MS=250

# Notification email links
# Base URL for links in notification emails. The "app" subdomain is replaced with the tenant slug.
# Example: https://app.dev.kanap.net -> https://mytenant.dev.kanap.net
APP_URL=https://app.kanap.net

# Email override (dev/QA only - NEVER use in production)
# When set, ALL outgoing emails are redirected to this address.
# Subject is prefixed with original recipient: "[To: user@example.com] Original Subject"
# EMAIL_OVERRIDE=developer@kanap.net

# Stripe billing (optional — billing is disabled when STRIPE_SECRET_KEY is unset)
# When enabled, STRIPE_WEBHOOK_SECRET and plan price IDs are required.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Hosted KANAP plan prices (single plan, monthly / annual)
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_ANNUAL=
# Enterprise Support (on-prem, annual only)
STRIPE_PRICE_ENTERPRISE_SUPPORT_ANNUAL=
# Optional override for EU bank-transfer rail country used in send_invoice flows (BE, DE, ES, FR, IE, NL)
STRIPE_EU_BANK_TRANSFER_COUNTRY=FR
# Notification email for enterprise support purchases (optional)
ENTERPRISE_SUPPORT_NOTIFY_EMAIL=
# Optional overrides; all three fall back to APP_URL when unset.
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
# Stripe API version (defaults to 2023-10-16 if unset)
STRIPE_API_VERSION=2025-09-30.clover
# Dev-only: set true to skip webhook signature verification (NEVER in production)
# STRIPE_WEBHOOK_ALLOW_INSECURE=false

# FX rates (optional — works without config using the free tier)
# FX_SPOT_BASE_URL=https://open.er-api.com/v6/latest
# FX_SPOT_API_KEY=

# Entra SSO (optional — all 4 must be set together to enable)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_AUTHORITY=https://login.microsoftonline.com/organizations
ENTRA_REDIRECT_URI=

# Token family signing keys (optional — see doc/on-premise/technical-design.md)
# Password-reset links and Entra SSO states sign with their own key, derived from JWT_SECRET via
# HMAC with a versioned label (kanap:v1:<family>) when the variable below is empty. A family never
# falls back to JWT_SECRET itself: an access token and a password-reset link are therefore not
# interchangeable. Changing a value invalidates that family's outstanding tokens (links in flight,
# SSO states).
# PASSWORD_RESET_SECRET=
# ENTRA_STATE_SECRET=
# Provisioning exchange tokens are minted by a service outside this repository, so their default
# stays JWT_SECRET (marker `provision`). Set this only in lockstep with that issuer: from the moment
# it is configured, it is the only accepted key.
# PROVISIONING_TOKEN_SECRET=

# Access-token purpose compatibility window (optional)
# Access tokens carry `purpose: 'access'`. Tokens minted before that marker was introduced stay
# accepted until the deadline below, which must be an ISO-8601 instant WITH an offset (`Z` or
# +HH:MM — a bare local timestamp is ambiguous) and in the future; it has to cover the longest
# JWT_ACCESS_TOKEN_TTL across the cut-over plus clock-skew tolerance. Unset, the window is computed
# per process start (JWT_ACCESS_TOKEN_TTL + JWT_CLOCK_SKEW_TOLERANCE_SEC) and renews with every
# restart — the start-up line says so in a warning. Pin it explicitly once the old instances are
# gone; after the deadline an untyped access token is 401.
# JWT_LEGACY_ACCESS_TOKEN_DEADLINE=YYYY-MM-DDTHH:MM:SS.sssZ
# JWT_CLOCK_SKEW_TOLERANCE_SEC=300

# Files storage (S3-compatible)
# Default backend: s3. Buckets per env: cio-dev|cio-qa|cio-prod
FILES_STORAGE=s3
S3_BUCKET=cio-dev
S3_REGION=nbg1
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_SSE=AES256

# AI features (all disabled by default)
# Enable each flag to activate the corresponding AI capability.
AI_CHAT_ENABLED=false
AI_MCP_ENABLED=false
AI_SETTINGS_ENABLED=false
# Optional timeout for each chat provider streaming request. Default: 300000 (5 minutes).
AI_CHAT_PROVIDER_TIMEOUT_MS=300000
# Encryption key for AI provider API keys (AES-256-GCM).
# Required when AI_SETTINGS_ENABLED=true. Generate with: openssl rand -base64 32
# WARNING: changing this value invalidates all previously stored API keys.
AI_SETTINGS_ENCRYPTION_SECRET=

# AI agent (helpdesk triage) — structured-JSON output budgets.
# Each agent LLM call (knowledge planner/interpreter, action planner, reply synthesis)
# must return a complete JSON object. A verbose / reasoning-style tenant model that runs
# past its budget is truncated (finish_reason=length) and the JSON never closes, which the
# control plane reports as a "truncated" failure and degrades to a technician escalation.
# These optional overrides raise the per-call max output tokens; sensible defaults (shown)
# are baked in, so set them only when a tenant model needs more room.
# AI_AGENT_NEED_BUILDER_MAX_TOKENS=5000
# AI_AGENT_KNOWLEDGE_PLANNER_MAX_TOKENS=4000
# AI_AGENT_KNOWLEDGE_INTERPRETER_MAX_TOKENS=4000
# AI_AGENT_ACTION_PLANNER_MAX_TOKENS=6000
# AI_AGENT_SYNTHESIS_MAX_TOKENS=8000
# Helpdesk GLPI ingestion triage processing budget per poll cycle (ms); detection/enqueue still runs for every agent.
# AI_AGENT_INGESTION_PROCESS_BUDGET_MS=210000

# AI agent multimodal (screenshot) evidence extraction.
# Vision is best-effort on the tenant's DEFAULT LLM (the one shared with Plaid chat) — no
# separate vision model/provider config. Whether to attempt it is a per-tenant admin-GUI
# setting ("Multimodal LLM", default ON); when the model is text-only the call fails or is
# ignored and triage silently degrades to text. The vars below are only extraction guardrails.
# AI_AGENT_VISION_EXTRACTION_MAX_TOKENS=12000
# AI_AGENT_VISION_EXTRACTION_TIMEOUT_MS=120000
# AI_AGENT_VISION_MAX_IMAGES=5
# AI_AGENT_VISION_MAX_IMAGE_BYTES=20971520

# Sample data (cloud only). An administrator loads the Fromage & Co set into an empty workspace;
# the API runs fixtures/fromage-co/setup-tenant.mjs, which calls this API on 127.0.0.1:$PORT.
# Loads running at once over all workspaces (default 2).
# DEMO_LOAD_MAX_CONCURRENT=2
