# =============================================================================
# Kadratis On-Premise Configuration
# Copy this file to ../.env (the repository root) and fill in the values:
#   cp infra/.env.onprem.example .env && chmod 600 .env
# The file holds every secret of the installation: keep it readable by its owner only.
# See doc/help/docs/en/on-premise/configuration.md for the full reference.
# After a change, apply it with: docker compose -f infra/compose.onprem.yml up -d api
# Generated by "npm run env:generate" in backend/ from backend/src/config/env-registry.ts:
# change the registry, not this file.
# =============================================================================

# DEPLOYMENT MODE (required)
# single-tenant or multi-tenant. Any other value stops the API. Unset means multi-tenant.
DEPLOYMENT_MODE=single-tenant

# TENANT CONFIGURATION (optional, defaults shown)
# Set DEFAULT_TENANT_SLUG before the first start. Changing it later creates a second, empty
# workspace. DEFAULT_TENANT_NAME is your organization's name at the first start: change it later
# on the Branding page of the administration. DEFAULT_TENANT_LANGUAGE (en, fr, de or es) names
# the analytics dimensions the workspace starts with, read at the first start only.
DEFAULT_TENANT_SLUG=default
DEFAULT_TENANT_NAME=My Organization
DEFAULT_TENANT_LANGUAGE=en

# ADMIN CREDENTIALS (required)
# These two lines create the first administrator account at the first start, and create or
# restore it at a later start when no active administrator remains. Changing them changes
# nothing while an active administrator exists.
# Replace the example password with a value of your own, 12 characters or more
# (for example the output of: openssl rand -base64 18). An example value or a shorter one makes
# the API print a [SECURITY] warning at each start until the account's password is changed.
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=ChangeThisPassword123!

# SECURITY (required)
# Generate with: openssl rand -hex 32
JWT_SECRET=
# TOKEN FAMILY KEYS (optional, see doc/on-premise/technical-design.md)
# Password-reset links, Entra SSO states, MCP connections and the "Cancel creation" option of a
# record just created derive their own key from JWT_SECRET when unset. Changing a value
# invalidates that family's outstanding tokens (reset links, SSO states, MCP access tokens).
# PASSWORD_RESET_SECRET=
# ENTRA_STATE_SECRET=
# MCP_OAUTH_CODE_SECRET=
# MCP_ACCESS_TOKEN_SECRET=
# CREATION_TOKEN_SECRET=
# Provisioning tokens come from a service outside this repository: their default stays JWT_SECRET.
# Set this only in lockstep with that issuer: it then becomes the only accepted key.
# PROVISIONING_TOKEN_SECRET=

# RUN MODE (recommended)
# Set APP_ENV=production as soon as users reach Kadratis over HTTPS.
# Unset, production rules apply to links, browser origins and platform administration, and a
# missing APP_BASE_URL or CORS_ORIGINS is a start-up warning. Set to production, start-up then
# requires APP_BASE_URL and CORS_ORIGINS and the session cookie is always marked Secure (it no
# longer works over plain HTTP).
# The public-form CAPTCHA stays off on single-tenant installs, whatever the run mode, unless CAPTCHA_MODE is set.
# APP_ENV=production

# APPLICATION URL (required: the address users open)
# Password reset and invitation links, notification links and the Entra sign-in redirect are
# built from it, not from the request's Host headers. Without it these features answer
# "application URL is not configured".
APP_BASE_URL=https://kadratis.your-domain.com

# CORS (required: the exact address users open Kadratis at, comma-separated if several)
# The address of APP_BASE_URL and the address of the request itself are always allowed; other
# browser origins get a 403. Unless APP_ENV=production, the request's address is compared on
# the host name when the proxy forwards Host without the port. A pattern such as
# https://*.your-domain.com is still accepted in this version with a start-up warning; use the
# exact address. If CORS_ORIGINS and APP_BASE_URL are both unset and APP_ENV is not production,
# every origin is still allowed in this version, with a start-up warning; a later version
# allows only the configured addresses.
CORS_ORIGINS=https://kadratis.your-domain.com

# CLIENT ADDRESS BEHIND THE PROXY (recommended)
# Kadratis reads the client address from X-Forwarded-For for its sign-in and request limits.
#   true   one reverse proxy in front of the API that sends X-Forwarded-For (the nginx of the guide)
#   false  nothing in front of the API: the address of the connection is used
#   2, 3   that many proxies in a row
# Unset, a single-tenant installation trusts one proxy and the API prints a [RATE-LIMIT] warning
# at each start. Keep the API port bound to 127.0.0.1 (compose.onprem.yml does).
RATE_LIMIT_TRUST_PROXY=true

# DATABASE (required)
# PostgreSQL 16 or later with the citext, pgcrypto, uuid-ossp, pg_trgm and unaccent extensions.
# Use a dedicated application role (not postgres or another cluster-admin role).
# sslmode=disable    PostgreSQL on the same server as Kadratis
# sslmode=require    the API checks the server certificate: it must come from a public authority
#                    (a private or self-signed certificate keeps the API from starting)
# sslmode=no-verify  encrypted connection without checking the certificate
# A password with @ : / # ? or % must be percent-encoded in the URL: use letters and digits
# (openssl rand -hex 24) and there is nothing to encode.
DATABASE_URL=postgres://kanap:password@your-postgres:5432/kanap?sslmode=require

# INTERNAL CERTIFICATE AUTHORITY (optional)
# Set it when your SMTP relay, PostgreSQL (sslmode=require or verify-full) or S3 store over HTTPS
# uses a certificate from your company's own authority. Put the PEM file in infra/certs/.
# NODE_EXTRA_CA_CERTS=/etc/kanap/certs/company-ca.pem

# STORAGE (required: S3-compatible object storage, the bucket must exist)
# S3_FORCE_PATH_STYLE: true for RustFS, MinIO, Garage and most self-hosted stores; false for AWS S3 and Cloudflare R2.
# S3_REGION: nbg1 when unset. Use us-east-1 for RustFS, the region of your provider otherwise.
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=kanap-files
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# FILES_STORAGE: s3 is the only storage; any other value also uses S3.
# FILES_STORAGE=s3

# EMAIL (optional: choose one transport)
# Enables: password reset, user invitations, notification digests
# Resend:
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM_EMAIL=Kadratis <noreply@yourdomain.com>
# SMTP (single-tenant only, wins over Resend when both are set).
# SMTP_USER and SMTP_PASSWORD go together: set both or neither.
# SMTP_HOST=smtp.company.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Kadratis <noreply@company.com>

# SSO (optional: Microsoft Entra ID, all four are required together)
# See doc/help/docs/en/on-premise/sso-entra.md
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
# ENTRA_REDIRECT_URI=https://kadratis.your-domain.com/api/auth/entra/callback
# false: the sign-in no longer reads the profile of the person in Microsoft Graph.
# ENTRA_ENRICH_PROFILE=true

# TECHNOLOGY CATALOG (optional, off by default on-premise)
# TECHNOLOGY_CATALOG_SYNC_ENABLED: reads the versions and end-of-support dates of the catalog
# entries your technologies come from (endoflife.date), every day, between two Kadratis versions.
# Off, each Kadratis version brings its own catalog at start. Needs outbound HTTPS to endoflife.date.
# Both go through the scheduled task "technology-catalog": disabled in the administration, nothing
# is synced, at start or daily.
# ENDOFLIFE_API_BASE_URL: optional mirror of the endoflife.date API v1.
# TECHNOLOGY_CATALOG_SYNC_ENABLED=false
# ENDOFLIFE_API_BASE_URL=

# VULNERABILITIES (optional, off by default on-premise)
# VULNERABILITY_FEED_ENABLED: reads the published vulnerabilities (NVD) of the products your
# technologies name, every 6 hours, and the exploitation signals (CISA, EU, EPSS, EUVD).
# Needs outbound HTTPS to services.nvd.nist.gov, raw.githubusercontent.com, epss.empiricalsecurity.com
# and euvdservices.enisa.europa.eu, or to your mirrors. One switch for every source.
# A source that cannot be reached leaves its columns and is named in the task summary.
# NVD_API_KEY: optional, raises the request rate (https://nvd.nist.gov/developers/request-an-api-key).
# NVD_API_BASE_URL: optional mirror of the NVD CVE API 2.0.
# KEV_FEED_URL, EPSS_FEED_URL, EUVD_BASE_URL: optional mirrors. Empty keeps the default address.
# KEV_FEED_URL defaults to CISA's GitHub mirror (raw.githubusercontent.com); www.cisa.gov answers
# 403 to data-centre addresses.
# An EPSS mirror may serve the file gzip or as plain CSV. An EUVD mirror serves both files under
# EUVD_BASE_URL: /api/kev/dump and /api/dump/cve-euvd-mapping.
# See EPSS at https://www.first.org/epss
# CVE_LIST_FEED_ENABLED: the CVE.org list, on with VULNERABILITY_FEED_ENABLED unless set to false.
# Without a mirror it needs outbound HTTPS to api.github.com, github.com and
# release-assets.githubusercontent.com.
# CVE_LIST_EXPORT_URL: a mirror of the full export (an http(s) address or the path of a file in
# the api container). CVE_LIST_RELEASES_URL, CVE_LIST_DOWNLOAD_URL: change them only behind a
# proxy that rewrites them.
# VULNERABILITY_FEED_ENABLED=false
# NVD_API_KEY=
# NVD_API_BASE_URL=
# KEV_FEED_URL=
# EPSS_FEED_URL=
# EUVD_BASE_URL=
# CVE_LIST_FEED_ENABLED=
# CVE_LIST_EXPORT_URL=
# CVE_LIST_RELEASES_URL=
# CVE_LIST_DOWNLOAD_URL=

# EXCEL IMPORTS (optional, on by default)
# IMPORT_XLSX: the data imports read an Excel workbook (.xlsx, its first sheet) as well as a CSV
# file. Set to false to accept CSV files only.
# IMPORT_XLSX=true

# EXCHANGE RATES (optional, defaults are fine)
# Key of the exchange rate service, when it needs one.
# FX_SPOT_API_KEY=
# Address of the service that gives the current exchange rates.
# FX_SPOT_BASE_URL=
# Milliseconds a current exchange rate is kept before it is read again.
# FX_SPOT_CACHE_TTL_MS=
# Milliseconds between two refreshes of the exchange rates started by a sign-in.
# FX_LOGIN_REFRESH_INTERVAL_MS=
# Days between two refreshes of the exchange rates started by a sign-in, when
# FX_LOGIN_REFRESH_INTERVAL_MS is unset.
# FX_LOGIN_REFRESH_INTERVAL_DAYS=
# Address of the World Bank API, the source of the yearly exchange rates.
# WB_BASE_URL=
# Address of the World Bank CSV file of the yearly exchange rates.
# WB_CSV_URL=
# Folder that keeps the World Bank CSV file between two reads.
# WB_CACHE_DIR=
# Milliseconds an answer of the World Bank API is kept.
# WB_CACHE_TTL_MS=
# Milliseconds the World Bank CSV file is kept before it is downloaded again.
# WB_CSV_CACHE_TTL_MS=
# Milliseconds before a new attempt when the World Bank API does not answer.
# WB_RETRY_DELAY_MS=

# AI FEATURES (optional, all off by default)
# AI_CHAT_ENABLED: the Kad chat assistant. AI_MCP_ENABLED: MCP access and AI API keys.
# AI_SETTINGS_ENABLED: the Artificial intelligence page of the administration (providers, models)
# and the agents.
# AI_SETTINGS_ENCRYPTION_SECRET: needed to store provider keys (openssl rand -hex 32). Changing
# it makes the stored keys unreadable: back it up with this file.
# AI_CHAT_ENABLED=false
# AI_MCP_ENABLED=false
# AI_SETTINGS_ENABLED=false
# AI_SETTINGS_ENCRYPTION_SECRET=
# BRAVE_SEARCH_API_KEY: lets Kad search the web. Each search sends its words to the Brave Search
# API (api.search.brave.com): open that host on the firewall.
# BRAVE_SEARCH_API_KEY=

# AI LIMITS (optional, defaults are fine)
# Longest answer of Kad, in tokens.
# AI_CHAT_MAX_TOKENS=16384
# Longest answer of Kad with a reasoning model, in tokens.
# AI_CHAT_REASONING_MAX_TOKENS=16384
# Milliseconds Kad waits for its AI provider, when the model sets no limit of its own.
# AI_CHAT_PROVIDER_TIMEOUT_MS=300000
# Most tool calls Kad makes for one answer.
# AI_CHAT_MAX_TOOL_ITERATIONS=40
# Searches without a new result after which Kad stops searching for one answer.
# AI_CHAT_SEARCH_ALL_NO_PROGRESS_CALL_THRESHOLD=4
# Days a conversation past its retention period is kept before it is deleted.
# AI_RETENTION_PURGE_GRACE_DAYS=30
# Agents: longest answer, in tokens, of the step that describes the need of a ticket.
# AI_AGENT_NEED_BUILDER_MAX_TOKENS=5000
# Agents: longest answer, in tokens, of the step that plans the knowledge search.
# AI_AGENT_KNOWLEDGE_PLANNER_MAX_TOKENS=4000
# Agents: longest answer, in tokens, of the step that reads the knowledge found.
# AI_AGENT_KNOWLEDGE_INTERPRETER_MAX_TOKENS=4000
# Agents: longest answer, in tokens, of the step that plans the actions.
# AI_AGENT_ACTION_PLANNER_MAX_TOKENS=6000
# Agents: longest administrative reply, in tokens.
# AI_AGENT_ADMINISTRATIVE_REPLY_MAX_TOKENS=3000
# Agents: longest reply to the requester, in tokens.
# AI_AGENT_SYNTHESIS_MAX_TOKENS=8000
# Agents: longest brief for the technician, in tokens.
# AI_AGENT_TECHNICIAN_BRIEF_MAX_TOKENS=3000
# Agents: longest diagnostic brief, in tokens.
# AI_AGENT_DIAGNOSTIC_BRIEF_MAX_TOKENS=6000
# Agents: longest reading of the screenshots of a ticket, in tokens.
# AI_AGENT_VISION_EXTRACTION_MAX_TOKENS=12000
# Agents: milliseconds the step that plans the actions waits for the model, when the model sets no
# limit of its own.
# AI_AGENT_ACTION_PLANNER_TIMEOUT_MS=120000
# Agents: milliseconds the diagnostic brief waits for the model, when the model sets no limit of its
# own.
# AI_AGENT_DIAGNOSTIC_BRIEF_TIMEOUT_MS=120000
# Agents: milliseconds the knowledge steps wait for the model, when the model sets no limit of its
# own.
# AI_AGENT_KNOWLEDGE_LLM_TIMEOUT_MS=120000
# Agents: milliseconds the replies wait for the model, when the model sets no limit of its own.
# AI_AGENT_REPLY_SYNTHESIS_TIMEOUT_MS=120000
# Agents: milliseconds the reading of screenshots waits for the model, when the model sets no limit
# of its own.
# AI_AGENT_VISION_EXTRACTION_TIMEOUT_MS=120000
# Agents: most screenshots read per ticket.
# AI_AGENT_VISION_MAX_IMAGES=5
# Agents: largest screenshot read, in bytes.
# AI_AGENT_VISION_MAX_IMAGE_BYTES=20971520
# Agents: milliseconds of ticket processing per run of the helpdesk task.
# AI_AGENT_INGESTION_PROCESS_BUDGET_MS=210000
# Agents: milliseconds of alert processing per run of the monitoring task.
# AI_AGENT_MONITORING_PROCESS_BUDGET_MS=210000
# Agents: 0 turns off the step that plans the actions.
# AI_AGENT_ACTION_PLANNER=
# Agents: 0 turns off the diagnostic brief.
# AI_AGENT_DIAGNOSTIC_BRIEF=
# Agents: 0 turns off the model in the planning of the knowledge search.
# AI_AGENT_KNOWLEDGE_LLM_PLANNER=
# Agents: 0 turns off the model in the description of the need of a ticket.
# AI_AGENT_NEED_BUILDER_LLM=
# Agents: 0 turns off the replies written by the model.
# AI_AGENT_REPLY_SYNTHESIS=

# OUTBOUND ADDRESSES AND EXPORTS (optional, empty by default)
# Private hosts or addresses the server may still call, comma-separated (an internal GLPI, for
# example). Every other private address stays refused.
# SSRF_ALLOWED_HOSTS=
# Hosts the document exports may fetch images from, comma-separated, in addition to the
# application's own address.
# EXPORT_ALLOWED_IMAGE_HOSTS=
# true lets the document exports fetch images from the server itself (localhost).
# EXPORT_ALLOW_LOOPBACK_IMAGE_HOSTS=false
# Address the document exports resolve relative image links against.
# EXPORT_MEDIA_BASE_URL=

# ADVANCED (optional, defaults are fine for most deployments)
# Token lifetimes: a number followed by s, m, h or d (another format becomes 15 minutes).
# JWT_ACCESS_TOKEN_TTL=15m
# JWT_REFRESH_TOKEN_TTL=4h
# Password reset link lifetime: a number of seconds or a duration such as 30m or 2h.
# PASSWORD_RESET_TTL=1h
# Invitation link lifetime (the link that sets the password), same format.
# INVITE_LINK_TTL=7d
# Access tokens carry a purpose marker; tokens without it, issued by older builds, are refused.
# To keep accepting them until a given instant, set an ISO-8601 instant with an offset (`Z` or
# +HH:MM). Leave it unset unless an older instance still issues tokens.
# JWT_LEGACY_ACCESS_TOKEN_DEADLINE=YYYY-MM-DDTHH:MM:SS.sssZ
# RATE_LIMIT_ENABLED=true
# LOG_LEVEL: debug or verbose adds the details of each scheduled job run to the log.
# LOG_LEVEL=
# NO_COLOR: any value turns off the colours of the log on a terminal.
# NO_COLOR=
# true: the cleanup of orphaned attachments lists the files it would delete and deletes none.
# ATTACHMENT_CLEANUP_DRY_RUN=false

# START-UP AND MIGRATIONS (optional, defaults are fine)
# true starts the API without running the database migrations first.
# SKIP_MIGRATIONS=false
# Attempts to reach the database before the migrations give up at start.
# MIGRATION_MAX_ATTEMPTS=30
# Milliseconds between two attempts to reach the database at start.
# MIGRATION_RETRY_DELAY_MS=2000
# Any value adds the details of a failed migration attempt to the log.
# DEBUG_MIGRATIONS=
# Repairs at start the documents linked to requests and projects: if-needed when the counts differ,
# always at every start.
# INTEGRATED_DOCS_AUTO_ROLLOUT=if-needed
# true stops the start when that repair fails, instead of logging the failure.
# INTEGRATED_DOCS_AUTO_ROLLOUT_STRICT=false
# Documents repaired per batch by that repair.
# INTEGRATED_DOCS_BATCH_SIZE=100
# Milliseconds of pause between two batches of that repair.
# INTEGRATED_DOCS_BATCH_PAUSE_MS=0
# Documents checked per batch after that repair.
# INTEGRATED_DOCS_VERIFY_BATCH_SIZE=200

# EMAIL QUEUE (optional, defaults are fine)
# Minimum milliseconds between two emails sent.
# EMAIL_QUEUE_MIN_INTERVAL_MS=
# Retries of an email Resend refused for its sending rate.
# EMAIL_RATE_LIMIT_MAX_RETRIES=5
# Milliseconds before the first of those retries, doubled at each one.
# EMAIL_RATE_LIMIT_RETRY_BASE_MS=1500
# Longest wait between two of those retries, in milliseconds.
# EMAIL_RATE_LIMIT_RETRY_MAX_MS=30000
# Random milliseconds added to each wait between those retries.
# EMAIL_RATE_LIMIT_RETRY_JITTER_MS=250

# CAPACITY (optional)
# See doc/help/docs/en/on-premise/configuration.md, "Capacity and performance".
# API processes in the API container (1 to 16). Each uses up to about 300 MB under load.
# API_WORKERS=1
# Database connections per API process (2 at least). API_WORKERS x DB_POOL_MAX must stay under
# PostgreSQL's max_connections minus about 15 (the API warns at start when it does not).
# DB_POOL_MAX=20
# On stop or upgrade, time given to the requests in progress, their notifications, running jobs
# and queued emails (ms; the container stops after 30 s).
# SHUTDOWN_DRAIN_TIMEOUT_MS=20000
# Enables GET /api/ops/metrics for a monitoring tool (24+ characters: openssl rand -hex 32).
# OPS_METRICS_TOKEN=

# DATABASE CONNECTIONS (optional, defaults are fine)
# Database connections each API process keeps open.
# DB_POOL_MIN=2
# Milliseconds after which an unused database connection is closed.
# DB_POOL_IDLE_TIMEOUT=30000
# Milliseconds the API waits for a new database connection.
# DB_POOL_CONNECTION_TIMEOUT=10000
# Name the API gives its connections in PostgreSQL (application_name).
# DB_APP_NAME=cio-api
# Milliseconds a request waits for a database lock (0: no limit).
# DB_LOCK_TIMEOUT_MS=5000
# Milliseconds a database statement of a request may run (0: no limit).
# DB_STATEMENT_TIMEOUT_MS=30000
# Milliseconds a request transaction may stay idle (0: no limit).
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
