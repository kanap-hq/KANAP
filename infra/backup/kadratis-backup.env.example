# Settings of kadratis-backup. Copy to /etc/kadratis-backup.env, then:
#   sudo chown root:root /etc/kadratis-backup.env && sudo chmod 600 /etc/kadratis-backup.env
# The script refuses to run when other users can read this file.
# One NAME=value per line, no `export`, no comment after a value. Quote a value that holds spaces.
# Read by the script and by kadratis-backup.service (EnvironmentFile=).

# --- Encryption ---------------------------------------------------------------------------------
# Public key(s) the backup is encrypted for (age1...), separated by spaces. Printed by
# `age-keygen -y <private key file>` on the machine that keeps the private key. Never put the
# private key (AGE-SECRET-KEY-...) on this server: the script refuses to run when it finds one.
BACKUP_AGE_RECIPIENTS=age1examplepublickeyreplacewiththeoutputofagekeygen000000000000000000

# --- Target bucket (write and list only) --------------------------------------------------------
# S3 endpoint of the target bucket, with https://. In the console of the storage provider.
BACKUP_S3_ENDPOINT=https://s3.example.com
# Region of the target bucket, as the provider names it. Leave empty if the provider has none.
BACKUP_S3_REGION=us-east-1
# Name of the target bucket. Use a bucket with versioning and object lock, for this backup only.
BACKUP_S3_BUCKET=example-backup-bucket
# Folder inside the bucket. Each night writes <prefix>/<UTC date and time>/. Default: kadratis.
BACKUP_S3_PREFIX=kadratis
# Access key of a user that may only write and list in the target bucket (no read, no delete).
BACKUP_S3_ACCESS_KEY_ID=EXAMPLEWRITEKEYID
# Secret key of that same user. Shown once by the provider when the key is created.
BACKUP_S3_SECRET_ACCESS_KEY=example-write-secret-key
# rclone provider name of the target: Other for most S3 services, AWS for Amazon S3. Default: Other.
BACKUP_S3_PROVIDER=Other
# true for path-style addresses (https://host/bucket), false for https://bucket.host. Default: true.
BACKUP_S3_FORCE_PATH_STYLE=true

# --- Database -----------------------------------------------------------------------------------
# Name of the Kadratis database: the database name in DATABASE_URL of the installation's .env.
BACKUP_DB_NAME=kanap
# System user that runs pg_dump on this server. Default: postgres.
BACKUP_DB_OS_USER=postgres

# --- Attachments (the file storage of the installation, read only) ------------------------------
# S3 endpoint of the file storage, as this server reaches it (S3_ENDPOINT of .env; for a store on
# this server, http://127.0.0.1:9000 rather than host.docker.internal).
ATTACHMENTS_S3_ENDPOINT=http://127.0.0.1:9000
# Region of the file storage (S3_REGION of .env).
ATTACHMENTS_S3_REGION=us-east-1
# Bucket of the file storage (S3_BUCKET of .env).
ATTACHMENTS_S3_BUCKET=kanap-files
# Access key of the file storage (AWS_ACCESS_KEY_ID of .env, or a key that may only read it).
ATTACHMENTS_S3_ACCESS_KEY_ID=EXAMPLEFILESKEYID
# Secret key of the file storage (AWS_SECRET_ACCESS_KEY of .env).
ATTACHMENTS_S3_SECRET_ACCESS_KEY=example-files-secret-key
# rclone provider name of the file storage: Other for RustFS, MinIO and most services. Default: Other.
ATTACHMENTS_S3_PROVIDER=Other
# S3_FORCE_PATH_STYLE of .env. Default: true.
ATTACHMENTS_S3_FORCE_PATH_STYLE=true

# --- Configuration and local files --------------------------------------------------------------
# Configuration files to back up, absolute paths separated by spaces: the installation's .env and
# the key file of the file storage (for example /etc/default/rustfs).
BACKUP_CONFIG_FILES="/opt/kanap/.env /etc/default/rustfs"
# Local directory: keeps the copy of the attachments between nights (in the clear: only root may
# read it) and the encrypted files of the night until they are uploaded. Default: /var/backups/kanap.
BACKUP_WORK_DIR=/var/backups/kanap

# --- Monitoring (optional) ----------------------------------------------------------------------
# Address called (GET) once the night is stored and checked, for a monitoring service that alerts
# when the call does not come. Leave empty for none. Treat it as a password.
BACKUP_SUCCESS_URL=

# --- Backups of a Hetzner Cloud server (optional) -----------------------------------------------
# Leave these empty unless the server runs on Hetzner Cloud with its backups turned on. When both
# are set, each night checks that the newest server backup is recent and then calls
# HETZNER_BACKUP_SUCCESS_URL. This check never makes the backup itself fail.
# Read-only API token of the Hetzner Cloud project (Console > Security > API tokens).
HETZNER_API_TOKEN=
# Numeric id of the server (Console > Servers > the server: the number in the page address).
HETZNER_SERVER_ID=
# Age in hours above which the newest server backup counts as missing. Default: 26.
HETZNER_BACKUP_MAX_AGE_HOURS=26
# Address called (GET) when the newest server backup is recent enough. Treat it as a password.
HETZNER_BACKUP_SUCCESS_URL=
# Address of the Hetzner Cloud API. Change it only to test against a simulated API.
#HETZNER_API_URL=https://api.hetzner.cloud/v1
