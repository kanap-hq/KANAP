# Development image of the local stack. node:24-alpine, multi-architecture index digest
# pinned on 2026-10-23 (later digests: Dependabot).
FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY tsconfig*.json vite.config.ts ./
COPY index.html ./
COPY public ./public
COPY src ./src
RUN npm run typecheck
EXPOSE 5173
# No default CMD; compose runs: npm run dev -- --host
