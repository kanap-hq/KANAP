# Development image of the local stack. node:24-alpine, multi-architecture index digest
# pinned on 2026-10-09 (later digests: Dependabot).
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY tsconfig*.json vite.config.ts ./
COPY index.html ./
COPY public ./public
COPY src ./src
RUN npm run typecheck
EXPOSE 5173
# No default CMD; compose runs: npm run dev -- --host
