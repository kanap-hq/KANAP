# Development image of the local stack. node:24-alpine, multi-architecture index digest
# pinned on 2026-10-23 (later digests: Dependabot).
FROM node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY tsconfig*.json vite.config.ts ./
COPY index.html ./
COPY src ./src
RUN npm run typecheck
# After the typecheck: public/dev-build.json (what this stack runs, written before each rebuild of
# the maintainer's dev stack) changes every time, and must not rerun the typecheck on its own.
COPY public ./public
EXPOSE 5173
# No default CMD; compose runs: npm run dev -- --host
