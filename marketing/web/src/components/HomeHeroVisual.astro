---
interface Props {
  mainSrc: string;
  mapSrc: string;
  budgetSrc: string;
}

const { mainSrc, mapSrc, budgetSrc } = Astro.props;
---

<figure class="mk-home-visual" aria-label="Kadratis product overview with AI, architecture and budget screenshots">
  <div class="mk-home-visual__brand">
    <img src="/brand/kadratis-logo-couleur.svg" alt="Kadratis" class="mk-home-visual__logo" width="603" height="145" loading="eager" decoding="async" />
  </div>

  <div class="mk-home-visual__signal" aria-hidden="true">
    <span class="mk-home-visual__signal-line mk-home-visual__signal-line--long"></span>
    <span class="mk-home-visual__signal-line"></span>
    <span class="mk-home-visual__signal-line mk-home-visual__signal-line--accent"></span>
  </div>

  <div class="mk-home-visual__rail" aria-hidden="true">
    <span>Budget</span>
    <span>Architecture</span>
    <span>Portfolio</span>
    <span>Knowledge</span>
    <span>AI</span>
  </div>

  <div class="mk-home-visual__screen mk-home-visual__screen--main">
    <img src={mainSrc} alt="Kad AI assistant answering a cross-module IT governance question" decoding="async" />
  </div>

  <div class="mk-home-visual__screen mk-home-visual__screen--map" aria-hidden="true">
    <img src={mapSrc} alt="" loading="lazy" decoding="async" />
  </div>

  <div class="mk-home-visual__screen mk-home-visual__screen--budget" aria-hidden="true">
    <img src={budgetSrc} alt="" loading="lazy" decoding="async" />
  </div>
</figure>

<style>
  .mk-home-visual {
    --mk-home-brand-navy: #154159;
    --mk-home-brand-teal: #1a6b7a;
    --mk-home-brand-orange: #ff8c00;
    position: relative;
    margin: 0;
    width: min(700px, calc(100% + 24px));
    margin-left: max(-24px, calc(100% - 700px));
    aspect-ratio: 2400 / 1260;
    overflow: hidden;
    border: 1px solid rgba(17, 24, 39, 0.12);
    border-radius: 12px;
    background:
      radial-gradient(circle at 16% 18%, rgba(255, 140, 0, 0.20) 0 5%, transparent 18%),
      radial-gradient(circle at 88% 22%, rgba(26, 107, 122, 0.30), transparent 28%),
      linear-gradient(116deg, #fbf8f1 0 37%, #eef6f3 37% 49%, var(--mk-home-brand-navy) 49% 100%);
    box-shadow: 0 18px 36px rgba(17, 24, 39, 0.15);
    isolation: isolate;
  }

  .mk-home-visual::before,
  .mk-home-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .mk-home-visual::before {
    opacity: 0.42;
    background-image:
      linear-gradient(rgba(21, 65, 89, 0.10) 1px, transparent 1px),
      linear-gradient(90deg, rgba(21, 65, 89, 0.08) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: linear-gradient(90deg, #000 0 50%, transparent 76%);
  }

  .mk-home-visual::after {
    background:
      linear-gradient(116deg, transparent 0 47.6%, rgba(255, 140, 0, 0.78) 47.8%, rgba(255, 140, 0, 0.78) 48.2%, transparent 48.4%),
      linear-gradient(116deg, transparent 0 51.5%, rgba(77, 184, 201, 0.34) 51.7%, transparent 52.2%),
      linear-gradient(180deg, transparent 0 76%, rgba(255, 255, 255, 0.16) 100%);
  }

  .mk-home-visual__brand {
    position: absolute;
    z-index: 5;
    top: 10%;
    left: 7%;
    display: inline-flex;
    align-items: center;
    gap: clamp(6px, 1vw, 9px);
    padding: clamp(5px, 0.9vw, 7px) clamp(9px, 1.3vw, 12px) clamp(5px, 0.9vw, 7px) clamp(6px, 1vw, 8px);
    border: 1px solid rgba(21, 65, 89, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 8px 16px rgba(21, 65, 89, 0.12);
    backdrop-filter: blur(12px);
  }

  .mk-home-visual__logo {
    display: block;
    width: auto;
    height: clamp(20px, 2.9vw, 30px);
  }

  .mk-home-visual__signal {
    position: absolute;
    z-index: 3;
    top: 39%;
    left: 9%;
    display: grid;
    gap: 7px;
    width: 22%;
    max-width: 150px;
  }

  .mk-home-visual__signal-line {
    display: block;
    height: 6px;
    width: 72%;
    border-radius: 999px;
    background: rgba(21, 65, 89, 0.18);
  }

  .mk-home-visual__signal-line--long {
    width: 100%;
    background: rgba(26, 107, 122, 0.24);
  }

  .mk-home-visual__signal-line--accent {
    width: 46%;
    background: rgba(255, 140, 0, 0.82);
  }

  .mk-home-visual__rail {
    position: absolute;
    z-index: 5;
    left: 8%;
    top: 57%;
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 7px 14px;
    max-width: 26%;
  }

  .mk-home-visual__rail span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--mk-home-brand-navy);
    font-size: clamp(8px, 1.05vw, 10px);
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
  }

  .mk-home-visual__rail span::before {
    content: '';
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(26, 107, 122, 0.72);
    box-shadow: 0 0 0 3px rgba(26, 107, 122, 0.10);
  }

  .mk-home-visual__rail span:nth-child(5)::before {
    background: var(--mk-home-brand-orange);
    box-shadow: 0 0 0 3px rgba(255, 140, 0, 0.14);
  }

  .mk-home-visual__screen {
    position: absolute;
    z-index: 2;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.62);
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.24);
  }

  .mk-home-visual__screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mk-home-visual__screen--main {
    top: 16%;
    right: -3%;
    width: 64%;
    aspect-ratio: 16 / 10;
    transform: perspective(1000px) rotateY(-8deg) rotateZ(1deg);
    transform-origin: center right;
  }

  .mk-home-visual__screen--map {
    right: 7%;
    bottom: 9%;
    width: 33%;
    aspect-ratio: 16 / 10;
    transform: rotateZ(-2.6deg);
  }

  .mk-home-visual__screen--budget {
    left: 38%;
    bottom: 17%;
    width: 27%;
    aspect-ratio: 16 / 10;
    transform: rotateZ(2deg);
  }

  @media (max-width: 720px) {
    .mk-home-visual {
      width: 100%;
      margin-left: 0;
      aspect-ratio: 4 / 3;
    }

    .mk-home-visual__rail {
      top: 18%;
      max-width: 62%;
    }

    .mk-home-visual__screen--main {
      top: 26%;
      right: -18%;
      width: 92%;
    }

    .mk-home-visual__screen--map {
      right: 7%;
      bottom: 8%;
      width: 42%;
    }

    .mk-home-visual__screen--budget {
      left: 9%;
      bottom: 18%;
      width: 38%;
    }
  }
</style>
