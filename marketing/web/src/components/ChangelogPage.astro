---
/**
 * ChangelogPage: /changelog for the current locale.
 *
 * Lists the published blog articles with topic `release`, newest first, in
 * the blog index's row rhythm (mono date left, title right). Locales without
 * their own release articles list the English ones with the "English" chip.
 * The technical list of changes lives on the GitHub releases page.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { Section, PageHeader, Callout } from './sections';
import { getLocaleFromUrl, useTranslations, DEFAULT_LOCALE } from '../i18n/ui';
import { getChangelogContent } from '../content/resolve';
import { getReleasePosts, formatDate } from '../lib/blog';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const c = getChangelogContent(locale);
const posts = await getReleasePosts(locale);
const minutes = (n: number) => t('blog.min').replace('{n}', String(n));
---

<BaseLayout title={c.meta.title} description={c.meta.description}>
  <PageHeader eyebrow={c.header.eyebrow} title={c.header.title} lead={c.header.lead} />

  <Section tone="default">
    <div class="mk-changelog">
      {posts.length > 0 ? (
        <ul class="mk-changelog__list">
          {posts.map((item) => (
            <li class="mk-changelog__row">
              <time datetime={item.post.data.date.toISOString()} class="mk-changelog__date">
                {formatDate(item.post.data.date, locale)}
              </time>
              <div class="mk-changelog__body">
                <h2><a href={item.href}>{item.post.data.title}</a></h2>
                <p>{item.post.data.description}</p>
                <a class="mk-changelog__read" href={item.href}>{t('blog.readArticle')} →</a>
              </div>
              <div class="mk-changelog__tail">
                {item.locale !== locale && item.locale === DEFAULT_LOCALE && (
                  <span class="mk-changelog__chip">{t('blog.inEnglish')}</span>
                )}
                <span>{minutes(item.readingMinutes)}</span>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mk-changelog__empty">{c.empty}</p>
      )}

      <Callout>
        <p><strong>{c.github.label}.</strong> {c.github.body} <a href={c.github.href} rel="noopener" target="_blank">{c.github.cta} →</a></p>
      </Callout>
    </div>
  </Section>
</BaseLayout>

<style>
  .mk-changelog {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 900px;
  }

  .mk-changelog__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mk-changelog__row {
    display: grid;
    grid-template-columns: 180px 1fr auto;
    gap: 28px;
    align-items: baseline;
    padding: 24px 0;
    border-bottom: 1px solid var(--kanap-border-soft);
  }

  .mk-changelog__row:first-child {
    padding-top: 8px;
  }

  .mk-changelog__date {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    color: var(--kanap-text-tertiary);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .mk-changelog__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .mk-changelog__body h2 {
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
    margin: 0;
  }

  .mk-changelog__body h2 a {
    color: var(--kanap-text-primary);
  }

  .mk-changelog__body h2 a:hover {
    color: var(--kanap-teal);
  }

  .mk-changelog__body p {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.6;
    max-width: 60ch;
    color: var(--kanap-text-secondary);
  }

  .mk-changelog__read {
    margin-top: 12px;
    font-size: 14px;
    font-weight: 500;
  }

  .mk-changelog__tail {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 12px;
    color: var(--kanap-text-tertiary);
    white-space: nowrap;
  }

  .mk-changelog__chip {
    display: inline-flex;
    align-items: center;
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1;
    padding: 4px 8px;
    border-radius: var(--kanap-radius-pill);
    background: var(--kanap-pill-bg);
    border: 1px solid var(--kanap-pill-border);
    color: var(--kanap-text-secondary);
  }

  .mk-changelog__empty {
    margin: 0;
    padding: 8px 0 24px;
    font-size: 15px;
    color: var(--kanap-text-secondary);
    border-bottom: 1px solid var(--kanap-border-soft);
  }

  @media (max-width: 680px) {
    .mk-changelog__row {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .mk-changelog__tail {
      order: -1;
    }
  }
</style>
