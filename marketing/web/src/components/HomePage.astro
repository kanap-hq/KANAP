---
/**
 * HomePage — full marketing homepage.
 *
 * Assembled from section primitives + content pulled from src/content/home
 * for the current locale. The agentic bands (layers / vision) are optional
 * in HomeContent: locales that have not been retranslated yet simply skip
 * them and render the core sections.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import {
  Hero,
  Section,
  PillarGrid,
  FeatureGrid,
  StoryBand,
  TrustStrip,
  CTABand,
} from './sections';
import HomeHeroVisual from './HomeHeroVisual.astro';
import { getLocaleFromUrl, localePath, useTranslations } from '../i18n/ui';
import { getHomeContent } from '../content/resolve';
import { HOME_HERO_SCREENSHOTS } from '../content/screenshots';
import { organizationLd, softwareApplicationLd } from '../lib/jsonld';
import { getPostsWithFallback, formatDate } from '../lib/blog';

const locale = getLocaleFromUrl(Astro.url);
const content = getHomeContent(locale);
const t = useTranslations(locale);

// "From the blog": up to three latest titles, one line each. Rendered only
// when there is something to list.
const latestPosts = (await getPostsWithFallback(locale)).slice(0, 3);
const site = (Astro.site ?? new URL('https://kanap.net')).href.replace(/\/$/, '');

// Feature cards: prefix module slugs with locale.
// The "Adopt at your pace" tile has no slug — it's a non-linking info card,
// so we skip the href when slug is missing.
const moduleItems = content.modules.items.map((m) => ({
  title: m.title,
  blurb: m.blurb,
  bullets: m.bullets,
  href: m.slug ? localePath(locale, m.slug) : undefined,
  ctaLabel: m.ctaLabel,
}));

// Cross-cutting: 2-column grid of short entries (no CTAs, no bullets)
const crossItems = content.crossCutting.items.map((i) => ({
  title: i.title,
  blurb: i.body,
}));
---

<BaseLayout title={content.meta.title} description={content.meta.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(organizationLd(site))} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationLd(site))} />
  </Fragment>
  <Hero
    eyebrow={content.hero.eyebrow}
    title={content.hero.title}
    lead={content.hero.lead}
  >
    <Fragment slot="cta">
      <a href="https://github.com/kanap-hq/kanap" class="mk-btn mk-btn--primary">
        {content.hero.primaryCta}
      </a>
      <a href={localePath(locale, '/trial/start')} class="mk-btn mk-btn--ghost">
        {content.hero.secondaryCta}
      </a>
    </Fragment>
    <Fragment slot="trust">
      <TrustStrip />
      <p class="mk-small mk-home__trial-note">{content.hero.trialNote}</p>
    </Fragment>
    <Fragment slot="visual">
      <HomeHeroVisual
        mainSrc={HOME_HERO_SCREENSHOTS.main}
        mapSrc={HOME_HERO_SCREENSHOTS.map}
        budgetSrc={HOME_HERO_SCREENSHOTS.budget}
      />
    </Fragment>
  </Hero>

  <Section tone="sunken">
    <PillarGrid
      eyebrow={content.pillars.eyebrow}
      title={content.pillars.title}
      pillars={content.pillars.items}
      columns={3}
    />
  </Section>

  {content.layers && (
    <Section tone="default">
      <PillarGrid
        eyebrow={content.layers.eyebrow}
        title={content.layers.title}
        intro={content.layers.intro}
        pillars={content.layers.items}
        columns={3}
      />
      <p class="mk-home__layers-outro">{content.layers.outro}</p>
    </Section>
  )}

  <Section tone="sunken">
    <FeatureGrid
      eyebrow={content.modules.eyebrow}
      title={content.modules.title}
      intro={content.modules.intro}
      items={moduleItems}
      columns={3}
    />
  </Section>

  <Section tone="default">
    <FeatureGrid
      eyebrow={content.crossCutting.eyebrow}
      title={content.crossCutting.title}
      intro={content.crossCutting.intro}
      items={crossItems}
      columns={2}
    />
  </Section>

  {content.vision && (
    <Section tone="sunken">
      <StoryBand
        eyebrow={content.vision.eyebrow}
        title={content.vision.title}
        body={content.vision.body}
        align="center"
      />
    </Section>
  )}

  {latestPosts.length > 0 && (
    <Section tone="default" compact>
      <div class="mk-home__blog">
        <div class="mk-home__blog-head">
          <span class="mk-eyebrow">{t('blog.home.eyebrow')}</span>
          <a href={localePath(locale, '/blog')} class="mk-home__blog-all">{t('blog.home.all')} →</a>
        </div>
        <ul class="mk-home__blog-list">
          {latestPosts.map((item) => (
            <li>
              <time datetime={item.post.data.date.toISOString()}>{formatDate(item.post.data.date, locale)}</time>
              <a href={item.href}>{item.post.data.title}</a>
            </li>
          ))}
        </ul>
      </div>
    </Section>
  )}

  <Section tone="default" compact>
    <CTABand
      title={content.cta.title}
      body={content.cta.body}
      primaryHref="https://github.com/kanap-hq/kanap"
      primaryLabel={content.cta.primary}
      secondaryHref={localePath(locale, '/trial/start')}
      secondaryLabel={content.cta.secondary}
    />
  </Section>
</BaseLayout>

<style>
  .mk-home__trial-note {
    margin-top: 6px;
    color: var(--kanap-text-tertiary);
  }

  .mk-home__layers-outro {
    margin: 28px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--kanap-text-primary);
    max-width: 640px;
  }

  .mk-home__blog {
    max-width: 900px;
  }

  .mk-home__blog-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--kanap-border-soft);
  }

  .mk-home__blog-all {
    font-size: 13px;
    font-weight: 500;
  }

  .mk-home__blog-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mk-home__blog-list li {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 20px;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--kanap-border-soft);
  }

  .mk-home__blog-list time {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--kanap-text-tertiary);
    white-space: nowrap;
  }

  .mk-home__blog-list a {
    font-size: 16px;
    line-height: 1.4;
    color: var(--kanap-text-primary);
  }

  .mk-home__blog-list a:hover {
    color: var(--kanap-teal);
  }

  @media (max-width: 560px) {
    .mk-home__blog-list li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
