---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Section, PageHeader } from './sections';
import { getLocaleFromUrl, relocatePath } from '../i18n/ui';
import type { Locale } from '../i18n/ui';
import type { LegalDoc } from '../content/legal/types';
import legalEn from '../content/legal/en';

interface Props {
  doc: LegalDoc;
}

// The French version is binding. Other locales point to it. `translation` is shown on a
// translated document, `untranslated` on one that falls back to the English text.
const NOTICES: Partial<Record<Locale, { translation: string; untranslated?: string; link: string }>> = {
  en: {
    translation: 'This document is a translation. The French version is the legally binding one and prevails in case of discrepancy.',
    link: 'French version',
  },
  de: {
    translation: 'Dieses Dokument ist eine Übersetzung. Die französische Fassung ist rechtsverbindlich und hat bei Abweichungen Vorrang.',
    untranslated: 'Dieses Dokument ist auf Französisch und Englisch verfügbar. Die französische Fassung ist rechtsverbindlich.',
    link: 'Französische Fassung',
  },
  es: {
    translation: 'Este documento es una traducción. La versión francesa es la jurídicamente vinculante y prevalece en caso de discrepancia.',
    untranslated: 'Este documento está disponible en francés y en inglés. La versión francesa es la jurídicamente vinculante.',
    link: 'Versión francesa',
  },
};

const { doc } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const entry = NOTICES[locale];
const englishFallback = locale !== 'en' && Object.values(legalEn).includes(doc);
const notice = entry && { text: (englishFallback && entry.untranslated) || entry.translation, link: entry.link };
const frenchHref = relocatePath(Astro.url, 'fr');
---

<BaseLayout title={doc.meta.title} description={doc.meta.description}>
  <PageHeader eyebrow={doc.header.eyebrow} title={doc.header.title}>
    <Fragment slot="meta">
      <span>{doc.header.lastUpdated}</span>
    </Fragment>
  </PageHeader>

  <Section tone="default">
    {notice && (
      <aside class="mk-legal-lang-notice">
        <p>{notice.text} <a href={frenchHref} hreflang="fr">{notice.link}</a></p>
      </aside>
    )}
    <article class="mk-legal" set:html={doc.body} />
  </Section>
</BaseLayout>

<style>
  .mk-legal-lang-notice {
    max-width: 760px;
    padding: 14px 18px;
    background: var(--kanap-bg-drawer);
    border: 1px solid var(--kanap-border-default);
    border-radius: var(--kanap-radius-composer);
    color: var(--kanap-text-secondary);
    font-size: 13px;
    line-height: 1.55;
    margin-bottom: 32px;
  }

  .mk-legal-lang-notice a {
    color: var(--kanap-teal);
  }

  .mk-legal {
    max-width: 760px;
    color: var(--kanap-text-secondary);
    font-size: 15px;
    line-height: 1.7;
  }

  .mk-legal :global(h2) {
    font-size: 18px;
    font-weight: 500;
    color: var(--kanap-text-primary);
    margin: 32px 0 12px;
    line-height: 1.3;
  }

  .mk-legal :global(h2:first-child) {
    margin-top: 0;
  }

  .mk-legal :global(h3) {
    font-size: 15px;
    font-weight: 500;
    color: var(--kanap-text-primary);
    margin: 24px 0 8px;
  }

  .mk-legal :global(p) {
    margin: 0 0 14px;
  }

  .mk-legal :global(ul) {
    margin: 0 0 14px;
    padding-left: 20px;
    list-style: disc;
  }

  .mk-legal :global(ul li) {
    margin-bottom: 6px;
  }

  .mk-legal :global(a) {
    color: var(--kanap-teal);
  }

  .mk-legal :global(a:hover) {
    color: var(--kanap-text-primary);
  }

  .mk-legal :global(strong) {
    color: var(--kanap-text-primary);
    font-weight: 500;
  }

  .mk-legal :global(.mk-legal__foot) {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--kanap-border-soft);
    font-size: 13px;
    color: var(--kanap-text-tertiary);
  }
</style>
